  reminders                                               reminders[]
  team_members                                            team_members[]
  teams                                                   teams[]
  user_notes                                              user_notes[]
  departments                                             departments?           @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "users_ibfk_1")

  @@index([department_id], map: "department_id")
  @@index([email], map: "idx_email")
  @@index([role_id], map: "idx_role_id")
  @@index([status], map: "idx_status")
  @@index([username], map: "idx_username")
}

