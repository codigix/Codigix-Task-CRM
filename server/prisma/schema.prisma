model task_subtasks {
  id                   Int           @id @default(autoincrement())
  task_id              Int
  title                String        @db.VarChar(255)
  description          String?       @db.LongText
  point_value          Int           @default(0)
  assigned_to_user_id  Int?
  completed_by_user_id Int?
  status               String?       @default("Pending") @db.VarChar(50)
  started_at           DateTime?     @db.Timestamp(0)
  completed_at         DateTime?     @db.Timestamp(0)
  created_by_user_id   Int?
  created_at           DateTime      @default(now()) @db.Timestamp(0)
  updated_at           DateTime      @default(now()) @updatedAt @db.Timestamp(0)
  general_tasks        general_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
}

model task_time_logs {
  id           Int            @id @default(autoincrement())
  task_id      Int
  subtask_id   Int?
  user_id      Int
  hours        Decimal        @db.Decimal(10, 2)
  description  String?        @db.LongText
  work_type    String?        @db.VarChar(100)
  status       String?        @default("Pending") @db.VarChar(50)
  approved_by  Int?
  approved_at  DateTime?      @db.Timestamp(0)
  started_at   DateTime?      @db.Timestamp(0)
  ended_at     DateTime?      @db.Timestamp(0)
  created_at   DateTime       @default(now()) @db.Timestamp(0)
  updated_at   DateTime       @default(now()) @updatedAt @db.Timestamp(0)
  general_tasks general_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([user_id])
}

model task_contributions {
  id                      Int           @id @default(autoincrement())
  task_id                 Int
  subtask_id              Int?
  user_id                 Int
  role                    String?       @db.VarChar(100)
  effort_points           Int           @default(0)
  contribution_percentage Decimal?      @db.Decimal(5, 2)
  contribution_source     String?       @db.VarChar(100)
  approval_status         String?       @default("Pending") @db.VarChar(50)
  approved_by             Int?
  approved_at             DateTime?     @db.Timestamp(0)
  created_at              DateTime      @default(now()) @db.Timestamp(0)
  updated_at              DateTime      @default(now()) @updatedAt @db.Timestamp(0)
  general_tasks           general_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([user_id])
}

model task_history {
  id                 Int           @id @default(autoincrement())
  task_id            Int
  changed_by_user_id Int?
  action_type        String        @db.VarChar(100)
  field_name         String?       @db.VarChar(100)
  old_value          String?       @db.Text
  new_value          String?       @db.Text
  reason             String?       @db.Text
  metadata           Json?
  created_at         DateTime      @default(now()) @db.Timestamp(0)
  general_tasks      general_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
}
