generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activities {
  id                                  Int                       @id @default(autoincrement())
  activity_type                       activities_activity_type? @default(Note)
  title                               String                    @db.VarChar(255)
  description                         String?                   @db.LongText
  status                              activities_status?        @default(Pending)
  priority                            activities_priority?      @default(Medium)
  contact_id                          Int?
  deal_id                             Int?
  project_id                          Int?
  company_id                          Int?
  lead_id                             Int?
  task_id                             Int?
  assigned_to                         Int?
  created_by                          Int?
  scheduled_date                      DateTime?                 @db.DateTime(0)
  scheduled_time                      DateTime?                 @db.Time(0)
  completed_date                      DateTime?                 @db.DateTime(0)
  duration_minutes                    Int?
  meeting_link                        String?                   @db.VarChar(500)
  notes                               String?                   @db.LongText
  created_at                          DateTime                  @default(now()) @db.Timestamp(0)
  updated_at                          DateTime                  @default(now()) @db.Timestamp(0)
  contacts                            contacts?                 @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activities_ibfk_1")
  deals                               deals?                    @relation(fields: [deal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activities_ibfk_2")
  projects                            projects?                 @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activities_ibfk_3")
  companies                           companies?                @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activities_ibfk_4")
  users_activities_assigned_toTousers users?                    @relation("activities_assigned_toTousers", fields: [assigned_to], references: [id], onUpdate: NoAction, map: "activities_ibfk_5")
  users_activities_created_byTousers  users?                    @relation("activities_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "activities_ibfk_6")
  leads                               leads?                    @relation(fields: [lead_id], references: [id], onUpdate: NoAction, map: "fk_activities_lead")
  general_tasks                       general_tasks?            @relation(fields: [task_id], references: [id], onUpdate: NoAction, map: "fk_activities_task")

  @@index([assigned_to], map: "assigned_to")
  @@index([created_by], map: "created_by")
  @@index([activity_type], map: "idx_activity_type")
  @@index([company_id], map: "idx_company_id")
  @@index([contact_id], map: "idx_contact_id")
  @@index([created_at], map: "idx_created_at")
  @@index([deal_id], map: "idx_deal_id")
  @@index([lead_id], map: "idx_lead_id")
  @@index([project_id], map: "idx_project_id")
  @@index([status], map: "idx_status")
  @@index([task_id], map: "idx_task_id")
}

model approvals {
  id                                  Int                 @id @default(autoincrement())
  approval_type                       String              @db.VarChar(100)
  entity_id                           Int?
  entity_name                         String?             @db.VarChar(255)
  description                         String?             @db.LongText
  requested_by                        Int?
  approver                            Int?
  priority                            approvals_priority? @default(Medium)
  status                              approvals_status?   @default(Pending)
  discount_percentage                 Decimal?            @db.Decimal(5, 2)
  discount_amount                     Decimal?            @db.Decimal(15, 2)
  change_scope                        String?             @db.LongText
  impact_assessment                   String?             @db.LongText
  approval_comments                   String?             @db.LongText
  created_at                          DateTime?           @default(now()) @db.Timestamp(0)
  updated_at                          DateTime?           @default(now()) @db.Timestamp(0)
  users_approvals_requested_byTousers users?              @relation("approvals_requested_byTousers", fields: [requested_by], references: [id], onUpdate: NoAction, map: "approvals_ibfk_1")
  users_approvals_approverTousers     users?              @relation("approvals_approverTousers", fields: [approver], references: [id], onUpdate: NoAction, map: "approvals_ibfk_2")

  @@index([approval_type], map: "idx_approval_type")
  @@index([approver], map: "idx_approver")
  @@index([created_at], map: "idx_created_at")
  @@index([status], map: "idx_status")
  @@index([requested_by], map: "requested_by")
}

model automation_rules {
  id                Int                          @id @default(autoincrement())
  name              String                       @db.VarChar(255)
  entity_type       automation_rules_entity_type
  trigger_condition String                       @db.Text
  action_type       String                       @db.VarChar(100)
  action_payload    Json?
  is_active         Boolean?                     @default(true)
  created_at        DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                    @default(now()) @db.Timestamp(0)
}

model automation_scripts {
  id           Int                        @id @default(autoincrement())
  test_case_id Int
  name         String                     @db.VarChar(255)
  status       automation_scripts_status? @default(Passed)
  last_run     DateTime?                  @default(now()) @db.Timestamp(0)
  test_cases   test_cases                 @relation(fields: [test_case_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "automation_scripts_ibfk_1")

  @@index([test_case_id], map: "test_case_id")
}

model bugs {
  id               Int            @id @default(autoincrement())
  project_id       Int
  title            String         @db.VarChar(255)
  module           String?        @db.VarChar(100)
  bug_type         String?        @default("Functional") @db.VarChar(100)
  status           bugs_status?   @default(Open)
  priority         bugs_priority? @default(Medium)
  severity         bugs_severity? @default(Minor)
  assignee         String?        @db.VarChar(100)
  reporter         String?        @db.VarChar(100)
  environment      String?        @default("QA") @db.VarChar(100)
  description      String?        @db.Text
  expected_results String?        @db.Text
  actual_results   String?        @db.Text
  steps            Json?
  attachments      Json?
  created_at       DateTime?      @default(now()) @db.Timestamp(0)
  updated_at       DateTime?      @default(now()) @db.Timestamp(0)
}

model call_history {
  id             Int                          @id @default(autoincrement())
  caller_name    String                       @db.VarChar(255)
  caller_email   String?                      @db.VarChar(150)
  caller_avatar  String?                      @db.LongText
  phone_number   String?                      @db.VarChar(20)
  call_type      call_history_call_type?      @default(Audio_Call)
  call_direction call_history_call_direction? @default(Outgoing)
  duration       Int?                         @default(0)
  started_at     DateTime?                    @db.Timestamp(0)
  ended_at       DateTime?                    @db.Timestamp(0)
  meeting_link   String?                      @db.VarChar(255)
  notes          String?                      @db.LongText
  created_by     Int?
  created_at     DateTime                     @default(now()) @db.Timestamp(0)
  updated_at     DateTime                     @default(now()) @db.Timestamp(0)

  @@index([call_type], map: "idx_call_type")
  @@index([caller_name], map: "idx_caller")
  @@index([created_at], map: "idx_created_at")
  @@index([call_direction], map: "idx_direction")
}

model campaign_performance {
  id           Int       @id @default(autoincrement())
  campaign_id  Int
  metric_name  String    @db.VarChar(100)
  metric_value Decimal   @db.Decimal(15, 2)
  recorded_at  DateTime  @db.Date
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  campaigns    campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "campaign_performance_ibfk_1")

  @@index([campaign_id], map: "idx_campaign_id")
  @@index([recorded_at], map: "idx_recorded_at")
}

model campaigns {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  description          String?                @db.LongText
  status               campaigns_status?      @default(Draft)
  start_date           DateTime?              @db.Date
  end_date             DateTime?              @db.Date
  budget               Decimal?               @db.Decimal(15, 2)
  currency             String?                @default("USD") @db.VarChar(10)
  created_by           Int?
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  campaign_performance campaign_performance[]
  marketing_projects   marketing_projects[]

  @@index([name], map: "idx_name")
  @@index([status], map: "idx_status")
}

model chat_group_members {
  id          Int                      @id @default(autoincrement())
  group_id    Int
  user_id     Int
  role        chat_group_members_role? @default(Member)
  joined_at   DateTime?                @default(now()) @db.Timestamp(0)
  chat_groups chat_groups              @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_group_members_ibfk_1")
  users       users                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_group_members_ibfk_2")

  @@unique([group_id, user_id], map: "unique_member")
  @@index([user_id], map: "user_id")
}

model chat_groups {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  description        String?              @db.Text
  department_id      Int?
  created_by         Int?
  avatar             String?              @db.LongText
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @default(now()) @db.Timestamp(0)
  chat_group_members chat_group_members[]
  departments        departments?         @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "chat_groups_ibfk_1")
  users              users?               @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "chat_groups_ibfk_2")
  messages           messages[]

  @@index([created_by], map: "created_by")
  @@index([department_id], map: "department_id")
}

model code_reviews {
  id                                    Int                  @id @default(autoincrement())
  project_id                            Int
  title                                 String               @db.VarChar(255)
  description                           String?              @db.Text
  pull_request_url                      String?              @db.VarChar(500)
  status                                code_reviews_status? @default(Pending)
  reviewer_id                           Int?
  author_id                             Int?
  created_at                            DateTime?            @default(now()) @db.Timestamp(0)
  updated_at                            DateTime?            @default(now()) @db.Timestamp(0)
  projects                              projects             @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "code_reviews_ibfk_1")
  users_code_reviews_reviewer_idTousers users?               @relation("code_reviews_reviewer_idTousers", fields: [reviewer_id], references: [id], onUpdate: NoAction, map: "code_reviews_ibfk_2")
  users_code_reviews_author_idTousers   users?               @relation("code_reviews_author_idTousers", fields: [author_id], references: [id], onUpdate: NoAction, map: "code_reviews_ibfk_3")

  @@index([author_id], map: "author_id")
  @@index([project_id], map: "idx_project_id")
  @@index([status], map: "idx_status")
  @@index([reviewer_id], map: "reviewer_id")
}

model commissions {
  id                                   Int                 @id @default(autoincrement())
  user_id                              Int
  deal_id                              Int?
  invoice_id                           Int?
  amount                               Decimal             @db.Decimal(15, 2)
  percentage                           Decimal?            @db.Decimal(5, 2)
  status                               commissions_status? @default(Pending)
  approved_by                          Int?
  approved_at                          DateTime?           @db.DateTime(0)
  paid_at                              DateTime?           @db.DateTime(0)
  notes                                String?             @db.Text
  created_at                           DateTime?           @default(now()) @db.Timestamp(0)
  updated_at                           DateTime?           @default(now()) @db.Timestamp(0)
  users_commissions_user_idTousers     users               @relation("commissions_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "commissions_ibfk_1")
  deals                                deals?              @relation(fields: [deal_id], references: [id], onUpdate: NoAction, map: "commissions_ibfk_2")
  invoices                             invoices?           @relation(fields: [invoice_id], references: [id], onUpdate: NoAction, map: "commissions_ibfk_3")
  users_commissions_approved_byTousers users?              @relation("commissions_approved_byTousers", fields: [approved_by], references: [id], onUpdate: NoAction, map: "commissions_ibfk_4")

  @@index([approved_by], map: "approved_by")
  @@index([deal_id], map: "deal_id")
  @@index([status], map: "idx_status")
  @@index([user_id], map: "idx_user_id")
  @@index([invoice_id], map: "invoice_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model companies {
  id                                          Int                   @id @default(autoincrement())
  company_name                                String                @db.VarChar(255)
  email                                       String?               @db.VarChar(150)
  phone                                       String?               @db.VarChar(20)
  website                                     String?               @db.VarChar(255)
  industry                                    String?               @db.VarChar(100)
  revenue                                     Decimal?              @db.Decimal(15, 2)
  employees                                   Int?
  description                                 String?               @db.Text
  logo                                        String?               @db.LongText
  address                                     String?               @db.VarChar(255)
  city                                        String?               @db.VarChar(100)
  state                                       String?               @db.VarChar(100)
  country                                     String?               @db.VarChar(100)
  zipcode                                     String?               @db.VarChar(20)
  status                                      companies_status?     @default(Active)
  created_by                                  Int?
  created_at                                  DateTime              @default(now()) @db.Timestamp(0)
  updated_at                                  DateTime              @default(now()) @db.Timestamp(0)
  facebook                                    String?               @db.VarChar(255)
  linkedin                                    String?               @db.VarChar(255)
  twitter                                     String?               @db.VarChar(255)
  whatsapp                                    String?               @db.VarChar(255)
  instagram                                   String?               @db.VarChar(255)
  skype                                       String?               @db.VarChar(255)
  email_opt_out                               Boolean?              @default(false)
  phone2                                      String?               @db.VarChar(20)
  fax                                         String?               @db.VarChar(20)
  reviews                                     String?               @db.VarChar(100)
  tags                                        String?               @db.VarChar(500)
  source                                      String?               @db.VarChar(100)
  currency                                    String?               @default("USD") @db.VarChar(10)
  language                                    String?               @default("English") @db.VarChar(50)
  owner                                       String?               @db.VarChar(255)
  visibility                                  companies_visibility? @default(Private)
  people_assigned                             String?               @db.LongText
  deals_text                                  String?               @db.Text
  activities                                  activities[]
  contacts                                    contacts[]
  contracts                                   contracts[]
  deals                                       deals[]
  entity_files                                entity_files[]
  entity_notes                                entity_notes[]
  estimations                                 estimations[]
  files                                       files[]
  invoices                                    invoices[]
  leads_leads_company_idTocompanies           leads[]               @relation("leads_company_idTocompanies")
  leads_leads_converted_company_idTocompanies leads[]               @relation("leads_converted_company_idTocompanies")
  projects                                    projects[]

  @@index([company_name], map: "idx_company_name")
  @@index([created_at], map: "idx_created_at")
  @@index([status], map: "idx_status")
}

model company_plans {
  id                   Int      @id @default(autoincrement())
  plan_name            String   @db.VarChar(255)
  plan_type            String?  @db.VarChar(100)
  plan_position        Int?
  plan_currency        String?  @db.VarChar(10)
  plan_currency_free   String?  @db.VarChar(10)
  discount_type        String?  @db.VarChar(50)
  discount             Decimal? @db.Decimal(10, 2)
  limitations_invoices Int?
  max_customers        Int?
  product              String?  @db.VarChar(255)
  supplier             String?  @db.VarChar(255)
  modules              String?  @db.LongText
  access_trial         Boolean? @default(false)
  trial_days           Int?
  status               String?  @db.VarChar(50)
  created_at           DateTime @default(now()) @db.Timestamp(0)
  updated_at           DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_created_at")
  @@index([plan_name], map: "idx_plan_name")
  @@index([status], map: "idx_status")
}

model contact_tasks {
  id                                     Int                     @id @default(autoincrement())
  title                                  String                  @db.VarChar(255)
  description                            String?                 @db.LongText
  contact_id                             Int
  status                                 contact_tasks_status?   @default(Open)
  priority                               contact_tasks_priority? @default(Medium)
  assigned_to                            Int?
  created_by                             Int?
  due_date                               DateTime?               @db.Date
  completed_date                         DateTime?               @db.DateTime(0)
  created_at                             DateTime                @default(now()) @db.Timestamp(0)
  updated_at                             DateTime                @default(now()) @db.Timestamp(0)
  contacts                               contacts                @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contact_tasks_ibfk_1")
  users_contact_tasks_assigned_toTousers users?                  @relation("contact_tasks_assigned_toTousers", fields: [assigned_to], references: [id], onUpdate: NoAction, map: "contact_tasks_ibfk_2")
  users_contact_tasks_created_byTousers  users?                  @relation("contact_tasks_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "contact_tasks_ibfk_3")

  @@index([assigned_to], map: "assigned_to")
  @@index([created_by], map: "created_by")
  @@index([contact_id], map: "idx_contact_id")
  @@index([due_date], map: "idx_due_date")
  @@index([status], map: "idx_status")
}

model contacts {
  id            Int              @id @default(autoincrement())
  first_name    String           @db.VarChar(100)
  last_name     String?          @db.VarChar(100)
  email         String?          @db.VarChar(150)
  phone         String?          @db.VarChar(20)
  company_id    Int?
  company_name  String?          @db.VarChar(255)
  position      String?          @db.VarChar(100)
  department    String?          @db.VarChar(100)
  source        String?          @db.VarChar(100)
  status        contacts_status? @default(Active)
  avatar        String?          @db.LongText
  notes         String?          @db.LongText
  created_at    DateTime         @default(now()) @db.Timestamp(0)
  updated_at    DateTime         @default(now()) @db.Timestamp(0)
  address       String?          @db.VarChar(255)
  city          String?          @db.VarChar(100)
  state         String?          @db.VarChar(100)
  country       String?          @db.VarChar(100)
  tag           String?          @db.VarChar(100)
  owner_id      Int?
  activities    activities[]
  contact_tasks contact_tasks[]
  companies     companies?       @relation(fields: [company_id], references: [id], onUpdate: NoAction, map: "contacts_ibfk_1")
  users         users?           @relation(fields: [owner_id], references: [id], onUpdate: NoAction, map: "fk_contacts_owner")
  entity_files  entity_files[]
  entity_notes  entity_notes[]
  files         files[]
  followups     followups[]
  leads         leads[]

  @@index([company_id], map: "idx_company_id")
  @@index([email], map: "idx_email")
  @@index([first_name], map: "idx_first_name")
  @@index([owner_id], map: "idx_owner_id")
  @@index([status], map: "idx_status")
}

model content_calendar {
  id             Int                           @id @default(autoincrement())
  project_id     Int
  title          String                        @db.VarChar(255)
  content_type   content_calendar_content_type
  scheduled_date DateTime                      @db.DateTime(0)
  status         content_calendar_status?      @default(Draft)
  assigned_to    Int?
  platform       String?                       @db.VarChar(100)
  created_at     DateTime?                     @default(now()) @db.Timestamp(0)
  updated_at     DateTime?                     @default(now()) @db.Timestamp(0)
  projects       projects                      @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "content_calendar_ibfk_1")
  users          users?                        @relation(fields: [assigned_to], references: [id], onUpdate: NoAction, map: "content_calendar_ibfk_2")

  @@index([assigned_to], map: "assigned_to")
  @@index([project_id], map: "idx_project_id")
  @@index([scheduled_date], map: "idx_scheduled_date")
  @@index([status], map: "idx_status")
}

model contracts {
  id             Int               @id @default(autoincrement())
  subject        String            @db.VarChar(255)
  start_date     DateTime          @db.Date
  end_date       DateTime          @db.Date
  client_id      Int
  contract_type  String            @db.VarChar(100)
  contract_value Decimal           @db.Decimal(15, 2)
  description    String?           @db.LongText
  status         contracts_status? @default(Draft)
  created_by     Int?
  created_at     DateTime          @default(now()) @db.Timestamp(0)
  updated_at     DateTime          @default(now()) @db.Timestamp(0)
  proposal_id    Int?
  deal_id        Int?
  files          String?           @db.LongText
  companies      companies         @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_ibfk_1")
  users          users?            @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "contracts_ibfk_2")
  proposals      proposals?        @relation(fields: [proposal_id], references: [id], onUpdate: NoAction, map: "contracts_ibfk_3")

  @@index([created_by], map: "created_by")
  @@index([client_id], map: "idx_client_id")
  @@index([created_at], map: "idx_created_at")
  @@index([end_date], map: "idx_end_date")
  @@index([proposal_id], map: "idx_proposal_id")
  @@index([start_date], map: "idx_start_date")
  @@index([status], map: "idx_status")
}

model conversations {
  id                                         Int        @id @default(autoincrement())
  participant1_id                            Int
  participant2_id                            Int
  last_message_text                          String?    @db.LongText
  last_message_timestamp                     DateTime   @default(now()) @db.Timestamp(0)
  created_at                                 DateTime   @default(now()) @db.Timestamp(0)
  updated_at                                 DateTime   @default(now()) @db.Timestamp(0)
  users_conversations_participant1_idTousers users      @relation("conversations_participant1_idTousers", fields: [participant1_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "conversations_ibfk_1")
  users_conversations_participant2_idTousers users      @relation("conversations_participant2_idTousers", fields: [participant2_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "conversations_ibfk_2")
  messages                                   messages[]

  @@unique([participant1_id, participant2_id], map: "unique_conversation")
  @@index([participant1_id], map: "idx_participant1_id")
  @@index([participant2_id], map: "idx_participant2_id")
  @@index([updated_at], map: "idx_updated_at")
}

model creative_requests {
  id                                          Int                            @id @default(autoincrement())
  project_id                                  Int
  title                                       String                         @db.VarChar(255)
  description                                 String?                        @db.LongText
  request_type                                creative_requests_request_type
  status                                      creative_requests_status?      @default(Requested)
  priority                                    creative_requests_priority?    @default(Medium)
  requested_by                                Int?
  assigned_to                                 Int?
  due_date                                    DateTime?                      @db.Date
  attachment_url                              String?                        @db.VarChar(500)
  created_at                                  DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at                                  DateTime?                      @default(now()) @db.Timestamp(0)
